<script>
function satTab(el, id) {
  document.querySelectorAll('.sat-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.sat-panel').forEach(p => p.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('sat-' + id).classList.add('active');
}
function satHisse(el, symbol) {
  document.querySelectorAll('.sat-btn').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('sat-chart-frame').src =
    'https://s.tradingview.com/widgetembed/?frameElementId=sat-chart-frame&symbol=' +
    encodeURIComponent(symbol) +
    '&interval=D&hidesidetoolbar=0&hidetoptoolbar=0&symboledit=1&saveimage=0&toolbarbg=0a1628&studies=RSI%40tv-basicstudies&theme=dark&style=1&timezone=Europe%2FIstanbul&locale=tr&utm_source=aydinyatirimnoktasi.com';
}
function satClock() {
  var now = new Date();
  var el = document.getElementById('sat-clock');
  if(el) el.textContent =
    String(now.getHours()).padStart(2,'0') + ':' +
    String(now.getMinutes()).padStart(2,'0') + ':' +
    String(now.getSeconds()).padStart(2,'0') + ' TRT';
}
satClock();
setInterval(satClock, 1000);
</script>

