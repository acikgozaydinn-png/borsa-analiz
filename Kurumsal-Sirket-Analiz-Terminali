  box-shadow: 0 0 60px rgba(0,100,255,0.06), inset 0 1px 0 rgba(0,150,255,0.1);
}

/* HEADER */
.sat-head {
  background: linear-gradient(90deg, #0a1628 0%, #0d1f38 100%);
  padding: 14px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #1a3050;
}
.sat-head-left { display: flex; align-items: center; gap: 10px; }
.sat-logo {
  font-family: 'Share Tech Mono', monospace;
  font-size: 13px;
  color: #3d9be9;
  letter-spacing: 2px;
  text-transform: uppercase;
}
.sat-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 6px #22c55e;
  animation: blink 2s infinite;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }
.sat-subtitle {
  font-size: 11px;
  color: #4a6a8a;
  letter-spacing: 1px;
  font-family: 'Share Tech Mono', monospace;
}

/* TICKER TAPE */
.sat-ticker { border-bottom: 1px solid #152a44; height: 46px; overflow: hidden; }

/* TABS */
.sat-tabs {
  display: flex;
  background: #080f1c;
  border-bottom: 1px solid #152a44;
  overflow-x: auto;
}
.sat-tab {
  padding: 10px 18px;
  font-size: 12px;
  color: #4a6a8a;
  cursor: pointer;
  border-bottom: 2px solid transparent;
  white-space: nowrap;
  transition: all 0.2s;
  letter-spacing: 0.5px;
  font-family: 'Share Tech Mono', monospace;
}
.sat-tab:hover { color: #7ab4d8; }
.sat-tab.active { color: #3d9be9; border-bottom-color: #3d9be9; background: rgba(61,155,233,0.05); }

/* PANELS */
.sat-panel { display: none; }
.sat-panel.active { display: block; }

/* SELECTOR */
.sat-selector {
  padding: 12px 16px;
  background: #080f1c;
  border-bottom: 1px solid #152a44;
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  align-items: center;
}
.sat-selector span {
  font-size: 11px;
  color: #4a6a8a;
  font-family: 'Share Tech Mono', monospace;
  margin-right: 4px;
}
.sat-btn {
  padding: 5px 12px;
  border: 1px solid #1a3050;
  background: transparent;
  color: #7ab4d8;
  font-family: 'Share Tech Mono', monospace;
  font-size: 11px;
  cursor: pointer;
  border-radius: 3px;
  transition: all 0.2s;
}
.sat-btn:hover, .sat-btn.active { background: #1a3050; color: #3d9be9; border-color: #3d9be9; }

/* CHART */
.sat-chart { width: 100%; height: 420px; background: #060d18; }
.sat-chart iframe { width: 100%; height: 100%; border: none; display: block; }

/* OVERVIEW */
.sat-overview { width: 100%; height: 500px; }
.sat-overview iframe { width: 100%; height: 100%; border: none; display: block; }

/* MINI GRID */
.sat-mini-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
.sat-mini-grid > div { height: 280px; border-right: 1px solid #152a44; border-bottom: 1px solid #152a44; }
.sat-mini-grid > div:nth-child(even) { border-right: none; }
.sat-mini-grid iframe { width:100%; height:100%; border:none; display:block; }

/* HABERLER */
.sat-news-wrap { padding: 16px; }
.sat-news-title {
  font-family: 'Share Tech Mono', monospace;
  font-size: 11px;
  color: #3d9be9;
  letter-spacing: 2px;
  margin-bottom: 14px;
  padding-bottom: 8px;
  border-bottom: 1px solid #152a44;
}
.sat-news-feed { width: 100%; height: 460px; border: none; display: block; }

/* FOOTER */
.sat-foot {
  background: #080f1c;
  border-top: 1px solid #152a44;
  padding: 10px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.sat-foot-txt { font-size: 10px; color: #2a4a6a; font-family: 'Share Tech Mono', monospace; }

/* DİSCLAIMER */
.sat-disclaimer {
