  padding: 12px 16px;
  font-size: 11px;
  color: #f0b429;
  text-align: center;
  font-family: 'Share Tech Mono', monospace;
  letter-spacing: 0.3px;
  line-height: 1.6;
}

@media (max-width: 600px) {
  .sat-mini-grid { grid-template-columns: 1fr; }
  .sat-mini-grid > div { border-right: none; }
  .sat-chart { height: 300px; }
}
</style>

